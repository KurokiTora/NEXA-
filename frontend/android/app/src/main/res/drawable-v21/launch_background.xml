<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch window: plain app background with the NEXA mark centred.
     It is replaced by the animated SplashPage as soon as Flutter renders. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/nexa_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/nexa_splash" />
    </item>
</layer-list>
